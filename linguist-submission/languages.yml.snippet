# Paste this block into lib/linguist/languages.yml in the github-linguist/linguist
# fork, in correct alphabetical position (between the "Ky..." / "L..." neighbours).
# Do NOT hand-write language_id: run `script/update-ids` after adding the block and
# it will fill in a unique id. Keep two-space indentation and the leading dash style
# used by the surrounding entries.
Kyte:
  type: programming
  color: "#6E56CF"
  extensions:
  - ".ky"
  - ".kyx"
  tm_scope: source.ky
  ace_mode: text
  # language_id: <generated by script/update-ids>
